# Sadhana -- Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.

# ── Auth ────────────────────────────────────────────────────────────
# Required when deployed to a non-localhost host.
# Without this, the proxy gate refuses to serve on non-localhost origins.
# SADHANA_PASSCODE=choose-a-strong-random-passcode

# ── Web Push (VAPID) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Required for push notifications. Optional for basic functionality.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExample...
# VAPID_PRIVATE_KEY=abc123...
# VAPID_SUBJECT=mailto:you@example.com

# ── YouTube Data API ────────────────────────────────────────────────
# Optional. Enables live YouTube search in addition to the curated library.
# Without this, only the curated video library is available.
# YOUTUBE_API_KEY=AIza...

# ── Database ────────────────────────────────────────────────────────
# Default: local SQLite file at .data/sadhana.db
# For Turso (hosted libSQL), set these:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
